---
// Chinmaya Satyanarayana Pooja (CSP) Initiative Section for Homepage
---

<section id="csp" class="py-16 md:py-24 bg-gradient-to-br from-maroon-50 via-maroon-50 to-burgundy-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-maroon-900 mb-4">
        Chinmaya Satyanarayana Pooja
      </h2>
      <p class="text-lg text-maroon-800 max-w-3xl mx-auto">
        A sacred opportunity to host a meaningful spiritual ceremony in your home, bringing the blessings of Lord Satyanarayana into your family.
      </p>
    </div>

    <!-- Three Pillars / Benefits -->
    <div class="grid md:grid-cols-3 gap-8 mb-20">
      <!-- Pillar 1: Deepen Sadhana -->
      <div class="bg-maroon-50 rounded-lg shadow-md p-8 border-l-4 border-maroon-600 hover:shadow-lg transition">
        <div class="w-12 h-12 bg-maroon-100 rounded-full flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-maroon-600" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"/>
          </svg>
        </div>
        <h3 class="text-xl font-serif font-bold text-maroon-900 mb-2">Deepen Sadhana</h3>
        <p class="text-maroon-800">
          Experience a profound spiritual practice within your own home, strengthening your connection to Lord Satyanarayana and deepening your personal spiritual journey.
        </p>
      </div>

      <!-- Pillar 2: Expand Community -->
      <div class="bg-maroon-50 rounded-lg shadow-md p-8 border-l-4 border-burgundy-600 hover:shadow-lg transition">
        <div class="w-12 h-12 bg-burgundy-100 rounded-full flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-burgundy-600" fill="currentColor" viewBox="0 0 20 20">
            <path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/>
            <path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/>
          </svg>
        </div>
        <h3 class="text-xl font-serif font-bold text-burgundy-900 mb-2">Expand Community</h3>
        <p class="text-maroon-800">
          Bring together family, friends, and neighbors in a sacred celebration that strengthens bonds and fosters spiritual community.
        </p>
      </div>

      <!-- Pillar 3: Streamlined Format -->
      <div class="bg-maroon-50 rounded-lg shadow-md p-8 border-l-4 border-maroon-600 hover:shadow-lg transition">
        <div class="w-12 h-12 bg-maroon-100 rounded-full flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-maroon-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v2h16V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
            <path fill-rule="evenodd" d="M4 11a1 1 0 011-1h10a1 1 0 011 1v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5z" clip-rule="evenodd"/>
          </svg>
        </div>
        <h3 class="text-xl font-serif font-bold text-maroon-900 mb-2">Streamlined Format</h3>
        <p class="text-maroon-800">
          A 90-minute ceremony perfected for modern households, with guided support at every step making it accessible and meaningful.
        </p>
      </div>
    </div>

    <!-- 5-Step Timeline -->
    <div class="bg-maroon-50 rounded-lg shadow-md p-12 mb-20 border-t-4 border-maroon-600">
      <h3 class="text-2xl font-serif font-bold text-maroon-900 mb-12 text-center">The 90-Minute Sacred Journey</h3>
      
      <div class="relative">
        <!-- Timeline Line -->
        <div class="hidden md:block absolute top-6 left-0 w-full h-1 bg-gradient-to-r from-maroon-200 via-orange-300 to-maroon-200"></div>
        
        <!-- Timeline Steps -->
        <div class="grid md:grid-cols-5 gap-6 md:gap-0 relative">
          <!-- Step 1 -->
          <div class="md:text-center">
            <div class="flex items-center justify-center mb-4">
              <div class="w-12 h-12 bg-gradient-to-br from-maroon-500 to-burgundy-500 rounded-full flex items-center justify-center text-white font-bold text-lg relative z-10 border-4 border-white shadow">
                1
              </div>
            </div>
            <h4 class="font-serif font-bold text-maroon-900 mb-1">Welcome</h4>
            <p class="text-sm text-maroon-700">5 minutes</p>
            <p class="text-sm text-maroon-700 mt-2">Opening prayers & invocation</p>
          </div>

          <!-- Step 2 -->
          <div class="md:text-center">
            <div class="flex items-center justify-center mb-4">
              <div class="w-12 h-12 bg-gradient-to-br from-burgundy-500 to-red-500 rounded-full flex items-center justify-center text-white font-bold text-lg relative z-10 border-4 border-white shadow">
                2
              </div>
            </div>
            <h4 class="font-serif font-bold text-burgundy-900 mb-1">Pooja</h4>
            <p class="text-sm text-maroon-700">30 minutes</p>
            <p class="text-sm text-maroon-700 mt-2">Sacred rituals & offerings</p>
          </div>

          <!-- Step 3 -->
          <div class="md:text-center">
            <div class="flex items-center justify-center mb-4">
              <div class="w-12 h-12 bg-gradient-to-br from-maroon-500 to-maroon-500 rounded-full flex items-center justify-center text-white font-bold text-lg relative z-10 border-4 border-white shadow">
                3
              </div>
            </div>
            <h4 class="font-serif font-bold text-maroon-900 mb-1">Katha</h4>
            <p class="text-sm text-maroon-700">30 minutes</p>
            <p class="text-sm text-maroon-700 mt-2">Sacred story & wisdom</p>
          </div>

          <!-- Step 4 -->
          <div class="md:text-center">
            <div class="flex items-center justify-center mb-4">
              <div class="w-12 h-12 bg-gradient-to-br from-burgundy-400 to-pink-500 rounded-full flex items-center justify-center text-white font-bold text-lg relative z-10 border-4 border-white shadow">
                4
              </div>
            </div>
            <h4 class="font-serif font-bold text-burgundy-900 mb-1">Bhajans</h4>
            <p class="text-sm text-maroon-700">15 minutes</p>
            <p class="text-sm text-maroon-700 mt-2">Devotional hymns</p>
          </div>

          <!-- Step 5 -->
          <div class="md:text-center">
            <div class="flex items-center justify-center mb-4">
              <div class="w-12 h-12 bg-gradient-to-br from-maroon-600 to-maroon-600 rounded-full flex items-center justify-center text-white font-bold text-lg relative z-10 border-4 border-white shadow">
                5
              </div>
            </div>
            <h4 class="font-serif font-bold text-maroon-950 mb-1">Prasadam</h4>
            <p class="text-sm text-maroon-700">10 minutes</p>
            <p class="text-sm text-maroon-700 mt-2">Divine offering & closure</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Host Kit Components -->
    <div class="bg-maroon-50 rounded-lg shadow-md p-12 mb-16 border-t-4 border-burgundy-600">
      <h3 class="text-2xl font-serif font-bold text-maroon-900 mb-8 text-center">Host Kit Includes</h3>
      
      <div class="grid md:grid-cols-4 gap-6">
        <!-- Kit Item 1 -->
        <div class="text-center">
          <div class="w-16 h-16 bg-gradient-to-br from-maroon-100 to-burgundy-100 rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-maroon-600" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
              <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 1 1 0 000 2H6a4 4 0 014 4v9a2 2 0 11-4 0V7H4a2 2 0 00-2 2v5a2 2 0 002 2h2.93a1 1 0 100-2H4V5z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h4 class="font-serif font-bold text-maroon-900 mb-2">Guided Script</h4>
          <p class="text-sm text-maroon-700">Easy-to-follow ceremony instructions</p>
        </div>

        <!-- Kit Item 2 -->
        <div class="text-center">
          <div class="w-16 h-16 bg-gradient-to-br from-burgundy-100 to-red-100 rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-burgundy-600" fill="currentColor" viewBox="0 0 20 20">
              <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z"/>
            </svg>
          </div>
          <h4 class="font-serif font-bold text-burgundy-900 mb-2">Complete Checklist</h4>
          <p class="text-sm text-maroon-700">Items needed and preparation steps</p>
        </div>

        <!-- Kit Item 3 -->
        <div class="text-center">
          <div class="w-16 h-16 bg-gradient-to-br from-maroon-100 to-maroon-100 rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-maroon-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 10-4 0v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h4 class="font-serif font-bold text-maroon-900 mb-2">Templates</h4>
          <p class="text-sm text-maroon-700">Customizable formats & arrangements</p>
        </div>

        <!-- Kit Item 4 -->
        <div class="text-center">
          <div class="w-16 h-16 bg-gradient-to-br from-burgundy-100 to-maroon-100 rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-burgundy-700" fill="currentColor" viewBox="0 0 20 20">
              <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"/>
            </svg>
          </div>
          <h4 class="font-serif font-bold text-maroon-900 mb-2">Volunteer Support</h4>
          <p class="text-sm text-maroon-700">Community guidance every step</p>
        </div>
      </div>
    </div>

    <!-- Call to Action -->
    <div class="text-center">
      <p class="text-maroon-800 mb-6 max-w-2xl mx-auto">
        Ready to bring the blessings of Lord Satyanarayana into your home? Learn more about hosting a CSP or register today.
      </p>
      <a 
        href="/csp" 
        class="inline-flex items-center justify-center bg-gradient-to-r from-maroon-600 to-burgundy-600 hover:from-maroon-700 hover:to-burgundy-700 text-white font-serif font-bold py-3 px-8 rounded-lg transition shadow-lg hover:shadow-xl"
      >
        Learn More & Register
        <svg class="w-5 h-5 ml-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>
  </div>
</section>
