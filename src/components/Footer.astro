---
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 bg-gradient-to-b from-maroon-900 to-maroon-950 text-maroon-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <div>
        <h3 class="text-2xl font-serif font-bold text-white">Chinmaya Mission San Antonio</h3>
        <p class="mt-3 text-maroon-200 leading-relaxed">
          "To give maximum happiness to maximum people for maximum time."
        </p>
      </div>

      <div>
        <h4 class="text-sm tracking-[0.2em] font-semibold text-gold uppercase">Contact Us</h4>
        <ul class="mt-4 space-y-3 text-maroon-100">
          <li>
            <a href="tel:+17262154913" class="hover:text-gold transition-colors">726-215-4913</a>
          </li>
          <li>
            <a href="mailto:info@chinmayasa.org" class="hover:text-gold transition-colors">info@chinmayasa.org</a>
          </li>
          <li>
            <a
              href="https://maps.google.com/?q=9086+Vista+Verde,+San+Antonio,+TX+78255"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-gold transition-colors"
            >
              9086 Vista Verde, San Antonio, TX 78255
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm tracking-[0.2em] font-semibold text-gold uppercase">Follow Us</h4>
        <ul class="mt-4 space-y-3">
          <li>
            <a
              href="https://www.facebook.com/ChinmayaMissionSAT"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-gold transition-colors"
            >
              Facebook
            </a>
          </li>
          <li>
            <a
              href="https://www.instagram.com/chinmayamissionsat/"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-gold transition-colors"
            >
              Instagram
            </a>
          </li>
          <li>
            <a
              href="https://youtube.com/@chinmayamissionsanantonio951?feature=shared"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-gold transition-colors"
            >
              YouTube
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-maroon-800 text-sm text-maroon-300">
      <p>© {currentYear} Chinmaya Mission San Antonio</p>
    </div>
  </div>
</footer>
