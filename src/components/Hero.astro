---
// Hero.astro - Immersive Hero block with mission statement and action buttons
// Features:
// - Large background container with ashram imagery
// - Centered elegant typography overlay
// - Two clear action buttons
---

<section class="relative h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style="background-image: url('https://images.unsplash.com/photo-1545056854-41a855fc8c64?w=1600&h=900&fit=crop');"
  ></div>

  <!-- Hero Content -->
  <div class="relative z-10 text-center max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-0">
    <!-- Decorative Top Element -->
    <div class="mb-6 flex justify-center">
      <div class="h-1 w-20 bg-gradient-to-r from-[#8B2F39] to-[#6B2027] rounded-full"></div>
    </div>

    <!-- Brand Name -->
    <h1
      class="text-5xl md:text-6xl lg:text-7xl font-serif font-bold text-white mb-6 leading-tight tracking-wide"
    >
      Chinmaya Mission <span class="whitespace-nowrap">San Antonio</span>
    </h1>

    <!-- Mission Statement -->
    <p class="text-xl md:text-2xl lg:text-3xl text-maroon-950 font-semibold mb-8 italic leading-relaxed max-w-3xl mx-auto">
      "To give maximum happiness to maximum people for maximum time."
    </p>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl text-maroon-950 mb-12 font-medium max-w-2xl mx-auto">
      Experience spiritual wisdom, cultural enrichment, and community connection through our sacred programs and services.
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row flex-wrap gap-4 justify-center">
      <!-- Weekly Schedule (Primary) -->
      <a
        href="/#our-weekly-programs"
        aria-label="Weekly Schedule — view weekly programs"
        class="w-full sm:w-auto px-10 py-4 bg-[#8B2F39] hover:bg-[#6B2027] text-white font-semibold rounded-lg shadow-lg transition-all duration-300 transform hover:scale-105 active:scale-95 text-lg text-center inline-flex items-center justify-center group focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#8B2F39]"
      >
        Weekly Schedule
      </a>

      <!-- Activities (Secondary) -->
      <a
        href="#activities"
        aria-label="Activities at Sharadalaya — explore activities"
        class="w-full sm:w-auto px-10 py-4 bg-[#f5f1ef] text-[#6B2027] border border-[#d5afa3] hover:bg-[#e0c3ba] font-semibold rounded-lg shadow-sm transition-all duration-300 transform hover:scale-105 active:scale-95 text-lg text-center inline-flex items-center justify-center group focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#8B2F39]"
      >
        Activities at Sharadalaya
      </a>

      <!-- CSP (Secondary) -->
      <a
        href="#csp"
        aria-label="Satyanarayana Pooja at your home — host a sacred ceremony"
        class="w-full sm:w-auto px-10 py-4 bg-[#f5f1ef] text-[#6B2027] border border-[#d5afa3] hover:bg-[#e0c3ba] font-semibold rounded-lg shadow-sm transition-all duration-300 transform hover:scale-105 active:scale-95 text-lg text-center inline-flex items-center justify-center group focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#8B2F39]"
      >
        Satyanarayana Pooja at your home
      </a>

      <!-- Jnanashakti (Secondary) -->
      <a
        href="#jnanashakti"
        aria-label="Sri Dandayudhapani Murti Sthaapana — learn about the installation"
        class="w-full sm:w-auto px-10 py-4 bg-[#f5f1ef] text-[#6B2027] border border-[#d5afa3] hover:bg-[#e0c3ba] font-semibold rounded-lg shadow-sm transition-all duration-300 transform hover:scale-105 active:scale-95 text-lg text-center inline-flex items-center justify-center group focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#8B2F39]"
      >
        Sri Dandayudhapani Murti Sthaapana
      </a>
    </div>

    <!-- Scroll Down Indicator -->
    <div class="mt-16 flex justify-center">
      <div class="animate-bounce">
        <svg
          class="w-6 h-6 text-[#8B2F39]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </div>
  </div>
</section>
