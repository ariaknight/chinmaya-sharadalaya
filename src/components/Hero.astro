---
// Hero.astro - Immersive Hero block with mission statement and action buttons
// Features:
// - Large background container with ashram imagery
// - Centered elegant typography overlay
// - Two clear action buttons
---

<section class="relative h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style="background-image: url('https://images.unsplash.com/photo-1545056854-41a855fc8c64?w=1600&h=900&fit=crop');"
  ></div>

  <!-- Hero Content -->
  <div class="relative z-10 text-center max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Decorative Top Element -->
    <div class="mb-6 flex justify-center">
      <div class="h-1 w-20 bg-gradient-to-r from-[#8B2F39] to-[#6B2027] rounded-full"></div>
    </div>

    <!-- Brand Name -->
    <h1
      class="text-5xl md:text-6xl lg:text-7xl font-serif font-bold text-white mb-6 leading-tight tracking-wide"
    >
      Chinmaya Mission <span class="whitespace-nowrap">San Antonio</span>
    </h1>

    <!-- Mission Statement -->
    <p class="text-xl md:text-2xl lg:text-3xl text-maroon-950 font-semibold mb-8 italic leading-relaxed max-w-3xl mx-auto">
      "To give maximum happiness to maximum people for maximum time."
    </p>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl text-maroon-950 mb-12 font-medium max-w-2xl mx-auto">
      Experience spiritual wisdom, cultural enrichment, and community connection through our sacred programs and services.
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row flex-wrap gap-4 justify-center">
      <!-- Weekly Schedule Button -->
      <a
        href="/schedule"
        class="px-8 py-4 bg-[#8B2F39] hover:bg-[#6B2027] text-white font-semibold rounded-lg shadow-lg transition-all duration-300 transform hover:scale-105 active:scale-95 text-lg inline-flex items-center justify-center group"
      >
        <svg
          class="w-5 h-5 mr-2 group-hover:rotate-12 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h18M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        Weekly Schedule
      </a>

      <!-- Activities Button -->
      <a
        href="#activities"
        class="px-8 py-4 bg-[#6B2027] hover:bg-[#5c1a1f] text-white font-semibold rounded-lg shadow-lg transition-all duration-300 transform hover:scale-105 active:scale-95 text-lg inline-flex items-center justify-center group"
      >
        Activities at Sharadalaya
      </a>

      <!-- CSP Button -->
      <a
        href="#csp"
        class="px-8 py-4 bg-[#8B2F39]/90 hover:bg-[#6B2027] text-white font-semibold rounded-lg shadow-lg transition-all duration-300 transform hover:scale-105 active:scale-95 text-lg inline-flex items-center justify-center group"
      >
        Satyanarayana Pooja at your home
      </a>

      <!-- Jnanashakti Button -->
      <a
        href="#jnanashakti"
        class="px-8 py-4 bg-[#6B2027]/90 hover:bg-[#5c1a1f] text-white font-semibold rounded-lg shadow-lg transition-all duration-300 transform hover:scale-105 active:scale-95 text-lg inline-flex items-center justify-center group"
      >
        Sri Dandayudhapani Murti Sthaapana
      </a>
    </div>

    <!-- Scroll Down Indicator -->
    <div class="mt-16 flex justify-center">
      <div class="animate-bounce">
        <svg
          class="w-6 h-6 text-[#8B2F39]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </div>
  </div>
</section>
