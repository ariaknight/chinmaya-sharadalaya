---
const email = 'mailto:info@chinmayasa.org?subject=CSP%20Registration%20Inquiry';
const phone = 'tel:+17262154913';

---

<section id="csp-hero" aria-label="Chinmaya Satyanarayana Pooja" class="bg-gradient-to-r from-maroon-50 to-burgundy-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
    <div class="pt-20 sm:pt-0 text-center">
      <div class="mb-6 flex justify-center">
        <div class="h-1 w-20 bg-gradient-to-r from-[#8B2F39] to-[#A0373D] rounded-full"></div>
      </div>

      <h1 class="text-4xl md:text-5xl font-serif font-bold text-maroon-900 leading-tight">
        Chinmaya Satyanarayana Pooja
      </h1>

      <p class="mt-4 text-lg text-maroon-800 max-w-3xl mx-auto">
        Host a sacred ceremony in your home and invite divine blessings. A streamlined 90-minute ritual to bring prosperity and spiritual fulfillment.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={email} class="inline-flex items-center justify-center bg-maroon-800 hover:bg-maroon-900 text-white font-serif font-bold py-3 px-8 rounded-lg focus:outline-none focus-visible:ring-4 focus-visible:ring-maroon-300 transition w-full sm:w-auto" aria-label="Email to register for CSP">
          Email to Register
        </a>

        <a href={phone} class="inline-flex items-center justify-center bg-maroon-50 text-maroon-800 hover:bg-burgundy-50 font-serif font-bold py-3 px-8 rounded-lg transition w-full sm:w-auto" aria-label="Call to register for CSP">
          Call Us: (726) 215-4913
        </a>
      </div>
    </div>
  </div>
</section>
