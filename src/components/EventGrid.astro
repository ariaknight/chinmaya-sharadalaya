---
// EventGrid.astro - Dynamic event layout component
// Features:
// - Fetches all items from the events collection
// - Sorts chronologically by order property
// - Responsive grid layout (1 col mobile, 2 col tablet, 3 col desktop)
// - Styled event cards with shadows and details

import { getCollection } from 'astro:content';

const events = await getCollection('events');
const sortedEvents = events.sort((a, b) => a.data.order - b.data.order);
---

<section class="py-16 bg-maroon-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-maroon-900 mb-4">
        Our Weekly Programs
      </h2>
      <p class="text-lg text-maroon-700 max-w-2xl mx-auto">
        Join us for inspiring spiritual programs, devotional practices, and community gatherings throughout the week.
      </p>
    </div>

    <!-- Events Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        sortedEvents.map((event) => (
          <article class="bg-maroon-50 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300 overflow-hidden group h-full flex flex-col">
            <!-- Card Header with Color Accent -->
            <div class="h-2 bg-gradient-to-r from-[#8B2F39] to-[#6B2027]"></div>

            <!-- Card Content -->
            <div class="p-6 flex flex-col flex-grow">
              <!-- Title -->
              <h3 class="text-2xl font-serif font-bold text-maroon-900 mb-2 group-hover:text-[#8B2F39] transition-colors">
                {event.data.title}
              </h3>

              <!-- Day & Time Badge -->
              <div class="flex flex-wrap items-center gap-2 mb-4">
                <span class="inline-flex items-center bg-[#8B2F39]/10 text-[#8B2F39] font-semibold px-3 py-1 rounded-full text-sm">
                  {event.data.dayOfWeek}
                </span>
                <span class="inline-flex items-center bg-maroon-100 text-maroon-800 font-medium px-3 py-1 rounded-full text-sm">
                  <svg
                    class="w-4 h-4 mr-1 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg>
                  {event.data.time}
                </span>
              </div>

              <!-- Location -->
              <div class="flex items-start mb-4 text-maroon-700">
                <svg
                  class="w-5 h-5 mr-2 mt-0.5 flex-shrink-0 text-[#8B2F39]"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  ></path>
                </svg>
                <span class="text-sm">{event.data.location}</span>
              </div>

              <!-- Instructor (if available) -->
              {event.data.instructor && (
                <div class="flex items-center mb-4 text-maroon-700">
                  <svg
                    class="w-5 h-5 mr-2 flex-shrink-0 text-[#8B2F39]"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    ></path>
                  </svg>
                  <span class="text-sm font-medium">{event.data.instructor}</span>
                </div>
              )}

              <!-- Description -->
              {event.data.description && (
                <p class="text-maroon-800 text-sm leading-relaxed mb-4 flex-grow">
                  {event.data.description}
                </p>
              )}

              <!-- Learn More Link -->
              <a
                href={`/events/${event.slug}`}
                class="inline-flex items-center text-[#8B2F39] hover:text-[#6B2027] font-semibold text-sm mt-auto transition-colors group"
              >
                Learn More
                <svg
                  class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Call to Action -->
    <div class="mt-12 text-center">
      <p class="text-maroon-700 mb-4">
        Want to learn more about all our programs and services?
      </p>
      <a
        href="/events"
        class="inline-block px-8 py-3 bg-[#8B2F39] hover:bg-[#6B2027] text-white font-semibold rounded-lg shadow-md transition-all duration-200 transform hover:scale-105 active:scale-95"
      >
        View All Events
      </a>
    </div>
  </div>
</section>

<style>
  article {
    animation: slideUp 0.6s ease-out backwards;
  }

  article:nth-child(1) {
    animation-delay: 0.1s;
  }

  article:nth-child(2) {
    animation-delay: 0.2s;
  }

  article:nth-child(3) {
    animation-delay: 0.3s;
  }

  article:nth-child(n + 4) {
    animation-delay: 0.4s;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
