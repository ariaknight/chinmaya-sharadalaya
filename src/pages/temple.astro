---
import Layout from '../layouts/Layout.astro';

const title = 'Sharadamba Temple - Chinmaya Mission San Antonio';
const description = 'Visit Sharadamba Temple. Learn about our presiding deities, temple history, location, hours, and how to participate in pujas and rituals.';
---

<Layout {title} {description}>
  <!-- Hero Section -->
  <section class="relative h-screen flex items-center justify-center overflow-hidden">
    <!-- Background Image -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style="background-image: url('https://images.unsplash.com/photo-1545056854-41a855fc8c64?w=1600&h=900&fit=crop');"
    ></div>

    <!-- Dark Gradient Overlay removed -->

    <!-- Hero Content -->
    <div class="relative z-10 text-center max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Decorative Top Element -->
      <div class="mb-6 flex justify-center">
        <div class="h-1 w-20 bg-gradient-to-r from-[#8B2F39] to-[#6B2027] rounded-full"></div>
      </div>
      
      <!-- Title -->
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-serif font-bold text-white mb-6 leading-tight tracking-wide">
        Mother Temple
      </h1>

      <!-- Mission Statement -->
      <p class="text-xl md:text-2xl lg:text-3xl text-maroon-950 font-semibold mb-8 italic leading-relaxed max-w-3xl mx-auto">
        Mother Temple of San Antonio - A sanctuary for spiritual seekers
      </p>

      <!-- Subtitle -->
      <p class="text-lg md:text-xl text-maroon-950 mb-12 font-medium max-w-2xl mx-auto">
        Experience divinity and tradition in our sacred space
      </p>
    </div>

    <!-- Scroll Down Indicator -->
    <div class="mt-16 flex justify-center">
      <div class="animate-bounce">
        <svg
          class="w-6 h-6 text-[#8B2F39]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </div>

    <!-- Decorative Bottom Curve removed -->
  </section>


  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Temple History -->
    <section class="mb-20">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-maroon-900 mb-8">
        Our Sacred Space
      </h2>
      <p class="text-lg text-maroon-800 mb-6">
        <strong>Established in 1984</strong>, Sharadamba Temple stands as the original and mother temple of Chinmaya Mission San Antonio, serving as a spiritual sanctuary among the rolling hills of our region. For decades, this sacred space has welcomed devotees, seekers, and families for worship, learning, and celebration.
      </p>
      <p class="text-lg text-maroon-800 mb-8">
        The temple embodies the teachings of Gurudev Swami Chinmayananda and provides a place where ancient Hindu wisdom meets contemporary spiritual practice. Our thoughtfully designed sanctum and gathering spaces honor traditional forms while serving the needs of our diverse community.
      </p>
    </section>

    <!-- Presiding Deities -->
    <section class="mb-20">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-maroon-900 mb-8">
        Presiding Deities
      </h2>
      <p class="text-lg text-maroon-800 mb-8">
        Our temple is blessed with the presence of beloved divine forms:
      </p>

      <div class="space-y-8">
        <!-- Goddess Sharadamba -->
        <div class="bg-gradient-to-r from-maroon-50 via-yellow-50 to-burgundy-50 rounded-lg overflow-hidden border-2 border-maroon-300 shadow-lg">
          <div class="md:flex">
            <div class="md:w-1/3 bg-gradient-to-br from-maroon-200 to-maroon-200 p-8 flex items-center justify-center">
              <div class="text-6xl">🔱</div>
            </div>
            <div class="p-8 md:w-2/3">
              <h3 class="text-2xl font-serif font-bold text-maroon-900 mb-2">Goddess Sharadamba</h3>
              <p class="text-maroon-800 font-serif italic mb-4">Embodiment of Brahmavidya (Divine Knowledge)</p>
              <p class="text-maroon-800">
                The primary presiding deity of our temple, Goddess Sharadamba represents divine wisdom, learning, and enlightenment. She is the embodiment of Brahmavidya - the supreme knowledge that liberates the soul. Devotees worship her seeking blessings for spiritual growth, intellectual clarity, and the wisdom to navigate life's challenges with grace and understanding.
              </p>
            </div>
          </div>
        </div>

        <!-- Lord Satyanarayana Swami -->
        <div class="bg-gradient-to-r from-burgundy-50 via-red-50 to-pink-50 rounded-lg overflow-hidden border-2 border-burgundy-300 shadow-lg">
          <div class="md:flex">
            <div class="md:w-1/3 bg-gradient-to-br from-burgundy-200 to-red-200 p-8 flex items-center justify-center">
              <div class="text-6xl">🙏</div>
            </div>
            <div class="p-8 md:w-2/3">
              <h3 class="text-2xl font-serif font-bold text-burgundy-900 mb-2">Lord Satyanarayana Swami</h3>
              <p class="text-burgundy-800 font-serif italic mb-4">The Truth-Sustaining Divine</p>
              <p class="text-maroon-800">
                Worshipped as the embodiment of truth and righteousness, Lord Satyanarayana Swami grants blessings of prosperity, health, and dharma (righteous living) to sincere devotees. Many families host the Chinmaya Satyanarayana Pooja ceremony to invoke his blessings for harmony, success, and spiritual fulfillment.
              </p>
            </div>
          </div>
        </div>

        <!-- Other Divine Presences -->
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-gradient-to-br from-maroon-50 to-maroon-50 p-6 rounded-lg border border-maroon-300">
            <h4 class="text-lg font-serif font-bold text-maroon-900 mb-3">Lakshmi-Narasimha</h4>
            <p class="text-maroon-800 text-sm">
              The divine union of abundance and protection, blessing devotees with prosperity and safe from obstacles.
            </p>
          </div>
          <div class="bg-gradient-to-br from-burgundy-50 to-maroon-50 p-6 rounded-lg border border-burgundy-300">
            <h4 class="text-lg font-serif font-bold text-burgundy-900 mb-3">Lord Ganesha</h4>
            <p class="text-maroon-800 text-sm">
              The remover of obstacles and lord of beginnings, invoked at the start of all sacred ceremonies and endeavors.
            </p>
          </div>
          <div class="bg-gradient-to-br from-maroon-50 to-red-50 p-6 rounded-lg border border-maroon-300">
            <h4 class="text-lg font-serif font-bold text-maroon-900 mb-3">Lord Shiva</h4>
            <p class="text-maroon-800 text-sm">
              The cosmic consciousness and lord of meditation, supporting devotees on their spiritual path of inner transformation.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Location & Hours -->
    <section class="mb-20">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-maroon-900 mb-8">
        Visit Us
      </h2>
      
      <div class="grid md:grid-cols-2 gap-8 mb-8">
        <div class="bg-gradient-to-br from-maroon-50 to-maroon-50 p-8 rounded-lg border-2 border-maroon-200">
          <h3 class="text-xl font-serif font-bold text-maroon-900 mb-6">Location & Contact</h3>
          <div class="space-y-4">
            <div>
              <p class="text-maroon-800 font-semibold">Address</p>
              <p class="text-maroon-800">9086 Vista Verde, San Antonio, TX 78250</p>
            </div>
            <div>
              <p class="text-maroon-800 font-semibold">Phone</p>
              <a href="tel:+17262154913" class="text-maroon-600 hover:text-maroon-800 font-semibold">
                (726) 215-4913
              </a>
            </div>
            <div>
              <p class="text-maroon-800 font-semibold">Email</p>
              <a href="mailto:info@chinmayasa.org" class="text-maroon-600 hover:text-maroon-800 font-semibold">
                info@chinmayasa.org
              </a>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-burgundy-50 to-red-50 p-8 rounded-lg border-2 border-burgundy-200">
          <h3 class="text-xl font-serif font-bold text-burgundy-900 mb-6">Current Hours</h3>
          <div class="space-y-3">
            <div class="flex justify-between">
              <span class="text-maroon-800">Monday - Friday</span>
              <span class="text-burgundy-800 font-semibold">6:00 PM - 8:00 PM</span>
            </div>
            <div class="flex justify-between">
              <span class="text-maroon-800">Saturday</span>
              <span class="text-burgundy-800 font-semibold">5:00 PM - 7:00 PM</span>
            </div>
            <div class="flex justify-between">
              <span class="text-maroon-800">Sunday</span>
              <span class="text-burgundy-800 font-semibold">9:00 AM - 12:00 PM</span>
            </div>
            <p class="text-sm text-burgundy-700 italic pt-4 border-t border-burgundy-300">
              Special hours during festivals and sacred occasions
            </p>
          </div>
        </div>
      </div>

      <!-- Google Maps Embed -->
      <div class="rounded-lg overflow-hidden shadow-lg border border-maroon-200 h-96">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3461.9866097532825!2d-98.37082!3d29.58944!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8644c9c8d3c3c3c3%3A0x3c3c3c3c3c3c3c3c!2s9086%20Vista%20Verde%2C%20San%20Antonio%2C%20TX%2078250!5e0!3m2!1sen!2sus!4v1234567890"
          width="100%"
          height="100%"
          style="border:0;"
          allowFullScreen=""
          loading="lazy"
          referrerPolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </section>

    <!-- How to Participate -->
    <section class="mb-20 bg-gradient-to-r from-maroon-50 to-burgundy-50 p-12 rounded-lg border-2 border-maroon-200">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-maroon-900 mb-8 text-center">
        Choose How to Participate
      </h2>
      
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-xl font-serif font-bold text-maroon-900 mb-4">Visit Our Temple</h3>
          <p class="text-maroon-800 mb-4">
            All are welcome to join us for daily pujas, special ceremonies, and spiritual gatherings. No experience or prior knowledge needed.
          </p>
          <a 
            href="tel:+17262154913"
            class="inline-flex items-center text-maroon-600 hover:text-maroon-800 font-semibold"
          >
            Call for more information →
          </a>
        </div>

        <div>
          <h3 class="text-xl font-serif font-bold text-burgundy-900 mb-4">Host a Ceremony</h3>
          <p class="text-maroon-800 mb-4">
            Bring the blessings of our deities into your home. We offer support for hosting pujas and other sacred ceremonies.
          </p>
          <a 
            href="/csp"
            class="inline-flex items-center text-burgundy-600 hover:text-burgundy-800 font-semibold"
          >
            Learn about hosting →
          </a>
        </div>
      </div>
    </section>

    <!-- Sponsorship & Support -->
    <section class="bg-gradient-to-r from-maroon-600 to-burgundy-600 text-white rounded-lg p-12 text-center">
      <h2 class="text-3xl font-serif font-bold mb-4">Support the Temple</h2>
      <p class="text-lg mb-8 max-w-2xl mx-auto">
        The temple thrives through community support and donations. Help us maintain this sacred space and expand our spiritual programs.
      </p>
      <a 
        href="/donate"
        class="inline-flex items-center justify-center bg-maroon-50 text-maroon-700 hover:bg-maroon-50 font-serif font-bold py-3 px-8 rounded-lg transition"
      >
        Support Our Mission
      </a>
    </section>
  </div>
</Layout>
