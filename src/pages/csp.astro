---
import Layout from '../layouts/Layout.astro';

const title = 'Chinmaya Satyanarayana Pooja - CMSA';
const description = 'Learn about hosting a Chinmaya Satyanarayana Pooja ceremony. Register your home for this sacred 90-minute spiritual experience.';
---

<Layout {title} {description}>
  <!-- Hero Section -->
  <section class="relative h-screen flex items-center justify-center overflow-hidden bg-gradient-to-r from-[#74272b] via-[#8B2F39] to-[#6B2027]">
    <!-- Hero Content -->
    <div class="relative z-10 text-center max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Decorative Top Element -->
      <div class="mb-6 flex justify-center">
        <div class="h-1 w-20 bg-gradient-to-r from-[#8B2F39] to-[#A0373D] rounded-full"></div>
      </div>
      
      <!-- Title -->
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-serif font-bold text-white mb-6 leading-tight tracking-wide">
        Chinmaya Satyanarayana Pooja
      </h1>

      <!-- Subtitle -->
      <p class="text-lg md:text-xl lg:text-2xl text-[#f5f1ef] font-light mb-6 italic leading-relaxed max-w-3xl mx-auto">
        Host a sacred ceremony in your home and invite divine blessings
      </p>

      <!-- Description -->
      <p class="text-lg md:text-xl text-[#f5f1ef] mb-12 font-light max-w-2xl mx-auto">
        A 90-minute ritual for prosperity and spiritual fulfillment
      </p>
    </div>

    <!-- Scroll Down Indicator -->
    <div class="absolute bottom-8 left-0 right-0 flex justify-center">
      <div class="animate-bounce">
        <svg class="w-6 h-6 text-[#d4af37]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </div>

    <!-- Decorative Bottom Curve -->
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-white to-transparent pointer-events-none"></div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- What is CSP? -->
    <section class="mb-20">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-maroon-900 mb-8">
        What is Chinmaya Satyanarayana Pooja?
      </h2>
      <p class="text-lg text-maroon-800 mb-6">
        The Chinmaya Satyanarayana Pooja is a sacred ritual worship of Lord Satyanarayana, believed to grant the blessings of health, prosperity, and spiritual fulfillment. This streamlined 90-minute ceremony has been adapted to fit modern family life while maintaining its spiritual depth and authenticity.
      </p>
      <p class="text-lg text-maroon-800 mb-6">
        Hosting a CSP in your home creates a meaningful opportunity for family and community to gather in devotion, strengthening both personal spirituality and familial bonds.
      </p>
      <div class="bg-maroon-50 border-l-4 border-maroon-600 p-6 rounded">
        <p class="text-maroon-900 font-serif italic">
          "The worship of Satyanarayana fulfills all righteous desires and grants material and spiritual prosperity to the devotee and their family."
        </p>
      </div>
    </section>

    <!-- Key Benefits -->
    <section class="mb-20">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-maroon-900 mb-8">
        The Three Sacred Pillars
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-gradient-to-br from-maroon-50 to-maroon-50 p-8 rounded-lg border border-maroon-200">
          <h3 class="text-xl font-serif font-bold text-maroon-900 mb-3">Deepen Sadhana</h3>
          <p class="text-maroon-800">
            Strengthen your personal spiritual practice and deepen your connection with the divine through this sacred ritual performed in the sanctuary of your home.
          </p>
        </div>
        <div class="bg-gradient-to-br from-burgundy-50 to-red-50 p-8 rounded-lg border border-burgundy-200">
          <h3 class="text-xl font-serif font-bold text-burgundy-900 mb-3">Expand Community</h3>
          <p class="text-maroon-800">
            Bring together family members, friends, neighbors, and fellow seekers in celebration, creating lasting spiritual bonds and community connections.
          </p>
        </div>
        <div class="bg-gradient-to-br from-maroon-50 to-maroon-50 p-8 rounded-lg border border-maroon-200">
          <h3 class="text-xl font-serif font-bold text-maroon-900 mb-3">Streamlined Format</h3>
          <p class="text-maroon-800">
            Experience the full spiritual benefits of this pooja in a practical 90-minute format, with comprehensive support and guidance at every step.
          </p>
        </div>
      </div>
    </section>

    <!-- 90-Minute Timeline -->
    <section class="mb-20 bg-maroon-50 p-12 rounded-lg">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-maroon-900 mb-12 text-center">
        The 90-Minute Sacred Journey
      </h2>
      
      <!-- Horizontal Timeline -->
      <div class="relative">
        <!-- Timeline Line -->
        <div class="hidden md:block absolute top-8 left-0 w-full h-1 bg-gradient-to-r from-maroon-200 via-burgundy-300 to-maroon-200"></div>
        
        <!-- Timeline Steps -->
        <div class="grid grid-cols-5 gap-4 md:gap-0 relative">
          <!-- Step 1: Welcome -->
          <div class="text-center">
            <div class="flex justify-center mb-6">
              <div class="w-16 h-16 bg-maroon-100 border-4 border-white shadow-lg rounded-full flex items-center justify-center relative z-10">
                <span class="text-2xl font-bold text-maroon-900">1</span>
              </div>
            </div>
            <h3 class="font-serif font-bold text-maroon-900 mb-1 text-sm md:text-base">Welcome</h3>
            <p class="text-xs md:text-sm text-maroon-700 mb-2">5 minutes</p>
            <p class="text-xs text-maroon-600 hidden md:block">Opening prayers &<br/>invocation</p>
          </div>

          <!-- Step 2: Pooja -->
          <div class="text-center">
            <div class="flex justify-center mb-6">
              <div class="w-16 h-16 bg-burgundy-300 border-4 border-white shadow-lg rounded-full flex items-center justify-center relative z-10">
                <span class="text-2xl font-bold text-white">2</span>
              </div>
            </div>
            <h3 class="font-serif font-bold text-burgundy-900 mb-1 text-sm md:text-base">Pooja</h3>
            <p class="text-xs md:text-sm text-burgundy-700 mb-2">30 minutes</p>
            <p class="text-xs text-burgundy-600 hidden md:block">Sacred rituals &<br/>offerings</p>
          </div>

          <!-- Step 3: Katha -->
          <div class="text-center">
            <div class="flex justify-center mb-6">
              <div class="w-16 h-16 bg-maroon-100 border-4 border-white shadow-lg rounded-full flex items-center justify-center relative z-10">
                <span class="text-2xl font-bold text-maroon-900">3</span>
              </div>
            </div>
            <h3 class="font-serif font-bold text-maroon-900 mb-1 text-sm md:text-base">Katha</h3>
            <p class="text-xs md:text-sm text-maroon-700 mb-2">30 minutes</p>
            <p class="text-xs text-maroon-600 hidden md:block">Sacred story &<br/>wisdom</p>
          </div>

          <!-- Step 4: Bhajans -->
          <div class="text-center">
            <div class="flex justify-center mb-6">
              <div class="w-16 h-16 bg-burgundy-300 border-4 border-white shadow-lg rounded-full flex items-center justify-center relative z-10">
                <span class="text-2xl font-bold text-white">4</span>
              </div>
            </div>
            <h3 class="font-serif font-bold text-burgundy-900 mb-1 text-sm md:text-base">Bhajans</h3>
            <p class="text-xs md:text-sm text-burgundy-700 mb-2">15 minutes</p>
            <p class="text-xs text-burgundy-600 hidden md:block">Devotional<br/>hymns</p>
          </div>

          <!-- Step 5: Prasadam -->
          <div class="text-center">
            <div class="flex justify-center mb-6">
              <div class="w-16 h-16 bg-maroon-100 border-4 border-white shadow-lg rounded-full flex items-center justify-center relative z-10">
                <span class="text-2xl font-bold text-maroon-900">5</span>
              </div>
            </div>
            <h3 class="font-serif font-bold text-maroon-900 mb-1 text-sm md:text-base">Prasadam</h3>
            <p class="text-xs md:text-sm text-maroon-700 mb-2">10 minutes</p>
            <p class="text-xs text-maroon-600 hidden md:block">Divine offering<br/>&amp; closure</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Host Kit -->
    <section class="mb-20">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-maroon-900 mb-8">
        Complete Host Kit
      </h2>
      <p class="text-lg text-maroon-800 mb-8">
        We provide everything you need to host a meaningful and authentic CSP ceremony in your home:
      </p>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-gradient-to-br from-maroon-50 to-maroon-100 p-8 rounded-lg border border-maroon-200">
          <h3 class="text-lg font-serif font-bold text-maroon-900 mb-4 flex items-center">
            <span class="w-8 h-8 bg-maroon-600 text-white rounded-full flex items-center justify-center mr-3 text-sm">✓</span>
            Guided Ceremony Script
          </h3>
          <p class="text-maroon-800">Easy-to-follow instructions with Sanskrit transliterations and English meanings for all rituals.</p>
        </div>

        <div class="bg-gradient-to-br from-burgundy-50 to-white p-8 rounded-lg border border-burgundy-200">
          <h3 class="text-lg font-serif font-bold text-burgundy-900 mb-4 flex items-center">
            <span class="w-8 h-8 bg-burgundy-600 text-white rounded-full flex items-center justify-center mr-3 text-sm">✓</span>
            Complete Checklist
          </h3>
          <p class="text-maroon-800">List of all items needed, where to source them, and step-by-step preparation guidelines.</p>
        </div>

        <div class="bg-gradient-to-br from-maroon-50 to-white p-8 rounded-lg border border-maroon-200">
          <h3 class="text-lg font-serif font-bold text-maroon-900 mb-4 flex items-center">
            <span class="w-8 h-8 bg-maroon-600 text-white rounded-full flex items-center justify-center mr-3 text-sm">✓</span>
            Customizable Templates
          </h3>
          <p class="text-maroon-800">Decorating ideas, invitation templates, and arrangement suggestions for your space.</p>
        </div>

        <div class="bg-gradient-to-br from-maroon-50 to-white p-8 rounded-lg border border-maroon-200">
          <h3 class="text-lg font-serif font-bold text-maroon-900 mb-4 flex items-center">
            <span class="w-8 h-8 bg-maroon-600 text-white rounded-full flex items-center justify-center mr-3 text-sm">✓</span>
            Volunteer Support
          </h3>
          <p class="text-maroon-800">Community guidance, Q&A support, and trained volunteers to assist throughout your ceremony.</p>
        </div>
      </div>
    </section>

    <!-- Registration CTA -->
    <section class="bg-gradient-to-r from-maroon-600 to-burgundy-600 text-white rounded-lg p-12 text-center">
      <h2 class="text-3xl font-serif font-bold mb-4">Ready to Host a CSP?</h2>
      <p class="text-lg mb-8 max-w-2xl mx-auto">
        Join the growing community of families who have embraced this sacred tradition. Register your home today and receive complete support for your ceremony.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="mailto:info@chinmayasa.org?subject=CSP%20Registration%20Inquiry"
          class="inline-flex items-center justify-center bg-maroon-50 text-maroon-700 hover:bg-maroon-50 font-serif font-bold py-3 px-8 rounded-lg transition"
        >
          Email to Register
        </a>
        <a 
          href="tel:+17262154913"
          class="inline-flex items-center justify-center bg-maroon-50 text-maroon-700 hover:bg-maroon-50 font-serif font-bold py-3 px-8 rounded-lg transition"
        >
          Call Us: (726) 215-4913
        </a>
      </div>
    </section>
  </div>
</Layout>
