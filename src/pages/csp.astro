---
import Layout from '../layouts/Layout.astro';
import CSPHero from '../components/CSPHero.astro';

const title = 'Chinmaya Satyanarayana Pooja - CMSA';
const description = 'Learn about hosting a Chinmaya Satyanarayana Pooja ceremony. Register your home for this sacred 90-minute spiritual experience.';
---

<Layout {title} {description}>
  <CSPHero />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- What is CSP? -->
    <section class="mb-20">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-maroon-900 mb-8">
        What is Chinmaya Satyanarayana Pooja?
      </h2>
      <p class="text-lg text-maroon-800 mb-6">
        The Chinmaya Satyanarayana Pooja is a sacred ritual worship of Lord Satyanarayana, believed to grant the blessings of health, prosperity, and spiritual fulfillment. This streamlined 90-minute ceremony has been adapted to fit modern family life while maintaining its spiritual depth and authenticity.
      </p>
      <p class="text-lg text-maroon-800 mb-6">
        Hosting a CSP in your home creates a meaningful opportunity for family and community to gather in devotion, strengthening both personal spirituality and familial bonds.
      </p>
      <div class="bg-maroon-50 border-l-4 border-maroon-600 p-6 rounded">
        <p class="text-maroon-900 font-serif italic">
          "The worship of Satyanarayana fulfills all righteous desires and grants material and spiritual prosperity to the devotee and their family."
        </p>
      </div>
    </section>

    <!-- Key Benefits -->
    <section class="mb-20">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-maroon-900 mb-8">
        The Three Sacred Pillars
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-gradient-to-br from-maroon-50 to-maroon-50 p-8 rounded-lg border border-maroon-200">
          <h3 class="text-xl font-serif font-bold text-maroon-900 mb-3">Deepen Sadhana</h3>
          <p class="text-maroon-800">
            Strengthen your personal spiritual practice and deepen your connection with the divine through this sacred ritual performed in the sanctuary of your home.
          </p>
        </div>
        <div class="bg-gradient-to-br from-maroon-50 to-maroon-100 p-8 rounded-lg border border-maroon-200">
          <h3 class="text-xl font-serif font-bold text-maroon-900 mb-3">Expand Community</h3>
          <p class="text-maroon-800">
            Bring together family members, friends, neighbors, and fellow seekers in celebration, creating lasting spiritual bonds and community connections.
          </p>
        </div>
        <div class="bg-gradient-to-br from-maroon-50 to-maroon-50 p-8 rounded-lg border border-maroon-200">
          <h3 class="text-xl font-serif font-bold text-maroon-900 mb-3">Streamlined Format</h3>
          <p class="text-maroon-800">
            Experience the full spiritual benefits of this pooja in a practical 90-minute format, with comprehensive support and guidance at every step.
          </p>
        </div>
      </div>
    </section>

    <!-- 90-Minute Timeline -->
    <section class="mb-20 bg-maroon-50 p-12 rounded-lg">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-maroon-900 mb-12 text-center">
        The 90-Minute Sacred Journey
      </h2>
      
      <!-- Horizontal Timeline -->
      <div class="relative">
        <!-- Timeline Line -->
        <div class="hidden md:block absolute top-8 left-0 w-full h-1 bg-gradient-to-r from-maroon-200 via-burgundy-300 to-maroon-200"></div>
        
        <!-- Timeline Steps -->
        <div class="grid grid-cols-5 gap-4 md:gap-0 relative">
          <!-- Step 1: Welcome -->
          <div class="text-center">
            <div class="flex justify-center mb-6">
              <div class="w-16 h-16 bg-burgundy-900 border-4 border-white shadow-lg rounded-full flex items-center justify-center relative z-10">
                <span class="text-2xl font-bold text-white">1</span>
              </div>
            </div>
            <h3 class="font-serif font-bold text-burgundy-900 mb-1 text-sm md:text-base">Welcome</h3>
            <p class="text-xs md:text-sm text-maroon-800 mb-2 font-semibold">5 minutes</p>
            <p class="text-xs text-maroon-900 hidden md:block font-semibold">Opening prayers &<br/>invocation</p>
          </div>

          <!-- Step 2: Pooja -->
          <div class="text-center">
            <div class="flex justify-center mb-6">
              <div class="w-16 h-16 bg-burgundy-900 border-4 border-white shadow-lg rounded-full flex items-center justify-center relative z-10">
                <span class="text-2xl font-bold text-white">2</span>
              </div>
            </div>
            <h3 class="font-serif font-bold text-burgundy-900 mb-1 text-sm md:text-base">Pooja</h3>
            <p class="text-xs md:text-sm text-maroon-900 mb-2 font-semibold">30 minutes</p>
            <p class="text-xs text-maroon-900 hidden md:block font-semibold">Sacred rituals &<br/>offerings</p>
          </div>

          <!-- Step 3: Katha -->
          <div class="text-center">
            <div class="flex justify-center mb-6">
              <div class="w-16 h-16 bg-burgundy-900 border-4 border-white shadow-lg rounded-full flex items-center justify-center relative z-10">
                <span class="text-2xl font-bold text-white">3</span>
              </div>
            </div>
            <h3 class="font-serif font-bold text-burgundy-900 mb-1 text-sm md:text-base">Katha</h3>
            <p class="text-xs md:text-sm text-maroon-800 mb-2 font-semibold">30 minutes</p>
            <p class="text-xs text-maroon-900 hidden md:block font-semibold">Sacred story &<br/>wisdom</p>
          </div>

          <!-- Step 4: Bhajans -->
          <div class="text-center">
            <div class="flex justify-center mb-6">
              <div class="w-16 h-16 bg-burgundy-900 border-4 border-white shadow-lg rounded-full flex items-center justify-center relative z-10">
                <span class="text-2xl font-bold text-white">4</span>
              </div>
            </div>
            <h3 class="font-serif font-bold text-burgundy-900 mb-1 text-sm md:text-base">Bhajans</h3>
            <p class="text-xs md:text-sm text-maroon-900 mb-2 font-semibold">15 minutes</p>
            <p class="text-xs text-maroon-900 hidden md:block font-semibold">Devotional<br/>hymns</p>
          </div>

          <!-- Step 5: Prasadam -->
          <div class="text-center">
            <div class="flex justify-center mb-6">
              <div class="w-16 h-16 bg-burgundy-900 border-4 border-white shadow-lg rounded-full flex items-center justify-center relative z-10">
                <span class="text-2xl font-bold text-white">5</span>
              </div>
            </div>
            <h3 class="font-serif font-bold text-burgundy-900 mb-1 text-sm md:text-base">Prasadam</h3>
            <p class="text-xs md:text-sm text-maroon-800 mb-2 font-semibold">10 minutes</p>
            <p class="text-xs text-maroon-900 hidden md:block font-semibold">Divine offering<br/>&amp; closure</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Host Kit -->
    <section class="mb-20">
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-maroon-900 mb-8">
        Complete Host Kit
      </h2>
      <p class="text-lg text-maroon-800 mb-8">
        We provide everything you need to host a meaningful and authentic CSP ceremony in your home:
      </p>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-gradient-to-br from-maroon-50 to-maroon-100 p-8 rounded-lg border border-maroon-200">
          <h3 class="text-lg font-serif font-bold text-maroon-900 mb-4 flex items-center">
            <span class="w-8 h-8 bg-maroon-600 text-white rounded-full flex items-center justify-center mr-3 text-sm">✓</span>
            Guided Ceremony Script
          </h3>
          <p class="text-maroon-800">Easy-to-follow instructions with Sanskrit transliterations and English meanings for all rituals.</p>
        </div>

        <div class="bg-gradient-to-br from-burgundy-50 to-white p-8 rounded-lg border border-burgundy-200">
          <h3 class="text-lg font-serif font-bold text-burgundy-900 mb-4 flex items-center">
            <span class="w-8 h-8 bg-burgundy-600 text-white rounded-full flex items-center justify-center mr-3 text-sm">✓</span>
            Complete Checklist
          </h3>
          <p class="text-maroon-800">List of all items needed, where to source them, and step-by-step preparation guidelines.</p>
        </div>

        <div class="bg-gradient-to-br from-maroon-50 to-white p-8 rounded-lg border border-maroon-200">
          <h3 class="text-lg font-serif font-bold text-maroon-900 mb-4 flex items-center">
            <span class="w-8 h-8 bg-maroon-600 text-white rounded-full flex items-center justify-center mr-3 text-sm">✓</span>
            Customizable Templates
          </h3>
          <p class="text-maroon-800">Decorating ideas, invitation templates, and arrangement suggestions for your space.</p>
        </div>

        <div class="bg-gradient-to-br from-maroon-50 to-white p-8 rounded-lg border border-maroon-200">
          <h3 class="text-lg font-serif font-bold text-maroon-900 mb-4 flex items-center">
            <span class="w-8 h-8 bg-maroon-600 text-white rounded-full flex items-center justify-center mr-3 text-sm">✓</span>
            Volunteer Support
          </h3>
          <p class="text-maroon-800">Community guidance, Q&A support, and trained volunteers to assist throughout your ceremony.</p>
        </div>
      </div>
    </section>

    <!-- Registration CTA -->
    <section class="bg-gradient-to-r from-maroon-600 to-burgundy-600 text-white rounded-lg p-12 text-center">
      <h2 class="text-3xl font-serif font-bold mb-4">Ready to Host a CSP?</h2>
      <p class="text-lg mb-8 max-w-2xl mx-auto">
        Join the growing community of families who have embraced this sacred tradition. Register your home today and receive complete support for your ceremony.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button
          id="open-csp-modal"
          class="inline-flex items-center justify-center bg-maroon-50 text-maroon-700 hover:bg-white font-serif font-bold py-3 px-8 rounded-lg transition"
        >
          Book a CSP
        </button>
        <a 
          href="tel:+17262154913"
          class="inline-flex items-center justify-center bg-maroon-50 text-maroon-700 hover:bg-maroon-50 font-serif font-bold py-3 px-8 rounded-lg transition"
        >
          Call Us: (726) 215-4913
        </a>
      </div>
    </section>
  </div>

  <!-- CSP Booking Modal -->
  <div id="csp-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg overflow-hidden">
      <!-- Modal Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-maroon-200">
        <h3 class="text-2xl font-serif font-bold text-maroon-900">Book a CSP</h3>
        <button id="close-csp-modal" class="text-maroon-500 hover:text-maroon-900 transition" aria-label="Close">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6h12v12" />
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <form id="csp-booking-form" class="p-6 space-y-5">
        <!-- Date (Saturday only) -->
        <div>
          <label for="csp-date" class="block text-sm font-semibold text-maroon-700 mb-1.5">Select Saturday</label>
          <input
            type="date"
            id="csp-date"
            class="w-full px-4 py-2.5 border border-maroon-200 rounded-lg text-maroon-900 focus:outline-none focus:ring-2 focus:ring-[#8B2F39] focus:border-transparent"
            required
          />
          <p id="date-error" class="hidden text-sm text-red-600 mt-1">Please select a Saturday.</p>
        </div>

        <!-- Time Slot -->
        <div>
          <span class="block text-sm font-semibold text-maroon-700 mb-1.5">Select Time Slot</span>
          <div class="flex flex-col sm:flex-row gap-3">
            <label class="flex-1 cursor-pointer">
              <input type="radio" name="timeSlot" value="10:30-12:00" class="peer sr-only" required />
              <div class="px-4 py-3 border border-maroon-200 rounded-lg text-center peer-checked:border-[#8B2F39] peer-checked:bg-[#8B2F39]/10 peer-checked:text-[#8B2F39] transition">
                <span class="font-semibold">10:30 AM – 12:00 PM</span>
              </div>
            </label>
            <label class="flex-1 cursor-pointer">
              <input type="radio" name="timeSlot" value="16:00-17:30" class="peer sr-only" required />
              <div class="px-4 py-3 border border-maroon-200 rounded-lg text-center peer-checked:border-[#8B2F39] peer-checked:bg-[#8B2F39]/10 peer-checked:text-[#8B2F39] transition">
                <span class="font-semibold">4:00 PM – 5:30 PM</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Host Details -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="host-name" class="block text-sm font-semibold text-maroon-700 mb-1.5">Your Name</label>
            <input
              type="text"
              id="host-name"
              class="w-full px-4 py-2.5 border border-maroon-200 rounded-lg text-maroon-900 focus:outline-none focus:ring-2 focus:ring-[#8B2F39] focus:border-transparent"
              placeholder="Full name"
              required
            />
          </div>
          <div>
            <label for="host-email" class="block text-sm font-semibold text-maroon-700 mb-1.5">Email Address</label>
            <input
              type="email"
              id="host-email"
              class="w-full px-4 py-2.5 border border-maroon-200 rounded-lg text-maroon-900 focus:outline-none focus:ring-2 focus:ring-[#8B2F39] focus:border-transparent"
              placeholder="you@example.com"
              required
            />
          </div>
        </div>

        <div>
          <label for="host-phone" class="block text-sm font-semibold text-maroon-700 mb-1.5">Phone Number</label>
          <input
            type="tel"
            id="host-phone"
            class="w-full px-4 py-2.5 border border-maroon-200 rounded-lg text-maroon-900 focus:outline-none focus:ring-2 focus:ring-[#8B2F39] focus:border-transparent"
            placeholder="(555) 123-4567"
            required
          />
        </div>

        <div>
          <label for="notes" class="block text-sm font-semibold text-maroon-700 mb-1.5">Notes (optional)</label>
          <textarea
            id="notes"
            rows="3"
            class="w-full px-4 py-2.5 border border-maroon-200 rounded-lg text-maroon-900 focus:outline-none focus:ring-2 focus:ring-[#8B2F39] focus:border-transparent resize-y"
            placeholder="Any special requests or additional information"
          ></textarea>
        </div>

        <!-- Messages -->
        <div id="booking-success" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm">
          Booking created successfully! We'll contact you soon to confirm.
        </div>
        <div id="booking-error" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"></div>

        <!-- Actions -->
        <div class="flex flex-col-reverse sm:flex-row gap-3 pt-2">
          <button
            type="button"
            id="cancel-booking"
            class="flex-1 px-6 py-3 border border-maroon-200 text-maroon-700 font-semibold rounded-lg hover:bg-maroon-50 transition"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="submit-booking"
            class="flex-1 px-6 py-3 bg-[#8B2F39] hover:bg-[#6B2027] text-white font-semibold rounded-lg shadow transition disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Submit Booking
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  // CSP Booking Modal Logic
  function initCSPBooking() {
    const openBtn = document.getElementById('open-csp-modal');
    const modal = document.getElementById('csp-modal');
    const closeBtn = document.getElementById('close-csp-modal');
    const cancelBtn = document.getElementById('cancel-booking');
    const form = document.getElementById('csp-booking-form') as HTMLFormElement;
    const dateInput = document.getElementById('csp-date') as HTMLInputElement;
    const dateError = document.getElementById('date-error') as HTMLParagraphElement;
    const successMsg = document.getElementById('booking-success') as HTMLDivElement;
    const errorMsg = document.getElementById('booking-error') as HTMLDivElement;
    const submitBtn = document.getElementById('submit-booking') as HTMLButtonElement;

    if (!openBtn || !modal) return;

    function openModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      // Reset form state
      form.reset();
      successMsg.classList.add('hidden');
      errorMsg.classList.add('hidden');
      dateError.classList.add('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Booking';
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    openBtn.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // ESC key closes modal
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Validate date is a Saturday
    dateInput.addEventListener('change', () => {
      dateError.classList.add('hidden');
      if (!dateInput.value) return;

      const selected = new Date(dateInput.value + 'T00:00:00');
      const day = selected.getDay(); // 0=Sun, 6=Sat
      if (day !== 6) {
        dateError.classList.remove('hidden');
        dateInput.value = '';
      }
    });

    // Form submission -> POST /api/bookings
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      successMsg.classList.add('hidden');
      errorMsg.classList.add('hidden');

      const date = dateInput.value;
      const timeSlot = (form.querySelector('input[name="timeSlot"]:checked') as HTMLInputElement)?.value;
      const name = (document.getElementById('host-name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('host-email') as HTMLInputElement).value.trim();
      const phone = (document.getElementById('host-phone') as HTMLInputElement).value.trim();
      const notes = (document.getElementById('notes') as HTMLTextAreaElement).value.trim();

      if (!date || !timeSlot) {
        errorMsg.textContent = 'Please select a date and time slot.';
        errorMsg.classList.remove('hidden');
        return;
      }

      const payload = {
        date,
        timeSlot,
        eventType: 'CSP',
        host: { name, email, phone },
        notes: notes || undefined
      };

      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';

      try {
        const res = await fetch('/api/bookings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json().catch(() => ({}));

        if (res.status === 201) {
          successMsg.classList.remove('hidden');
          // Auto-close after success
          setTimeout(() => {
            closeModal();
          }, 2200);
        } else if (res.status === 409) {
          errorMsg.textContent = data.error || 'That time slot is already booked. Please choose another.';
          errorMsg.classList.remove('hidden');
        } else {
          errorMsg.textContent = data.error || 'Unable to create booking. Please try again.';
          errorMsg.classList.remove('hidden');
        }
      } catch (err: any) {
        errorMsg.textContent = 'Network error. Please check your connection and try again.';
        errorMsg.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Booking';
      }
    });
  }

  if (typeof window !== 'undefined') {
    // Initialize after DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCSPBooking);
    } else {
      initCSPBooking();
    }
  }
</script>
